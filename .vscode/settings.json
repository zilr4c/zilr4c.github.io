{
  // --- Configuraciones de Formateo y Lenguajes ---
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "files.associations": {
    "*.html": "liquid"
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "[html][liquid]": {
    "editor.defaultFormatter": "Shopify.theme-check-vscode"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mkhl.shfmt"
  },

  // --- Validación de CSS/Estilos ---
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,
  "stylelint.snippet": ["css", "scss"],
  "stylelint.validate": ["css", "scss"],

  // --- Terminal y Sistema ---
  "terminal.integrated.profiles.osx": {
    "zsh": { "path": "/bin/zsh", "args": ["-l", "-i"] }
  },

  // --- CONFIGURACIÓN DE IMÁGENES ---
  "markdown.copyFiles.destination": {
    "**/*.md": "/assets/img/posts/kerberos-lab-attack/${fileName}"
  },
  "markdown.copyFiles.pastedFileName": "img-${date:mmSSS}",
  "editor.pasteAs.enabled": true
}
